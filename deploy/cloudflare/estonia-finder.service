[Unit]
Description=Estonia Company Finder
After=network-online.target
Wants=network-online.target

[Service]
User=finder
Group=finder
WorkingDirectory=/opt/estonia_amending_entry
EnvironmentFile=/etc/estonia-finder.env
# One worker on purpose: search jobs and results are kept in memory.
# Threads handle concurrent users; long searches run as background jobs.
ExecStart=/opt/estonia_amending_entry/venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 127.0.0.1:5050 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
